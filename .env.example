# Copy to .env and fill in. Viam app -> machine -> CONNECT tab -> API keys.
API_KEY=""
API_KEY_ID=""
ROBOT_ADDRESS="armfarm10-main.310sld03v2.viam.cloud"

# Only needed for the material / brand stages.
ANTHROPIC_API_KEY=""

# --mode label: where the local label reader (Ollama) runs. Default: this laptop.
# A teammate's laptop works too: they start it with OLLAMA_HOST=0.0.0.0 ollama serve
# OLLAMA_URL=http://localhost:11434
# VISION_MODEL=qwen2.5vl:7b

# Log level of the Viam SDK on connect (default INFO). pipeline.py uses WARNING on its own.
# VIAM_LOG_LEVEL=INFO
